# Python 가상환경, 캐시, 테스트 및 빌드 산출물
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.tmp

# 환경 파일과 인증정보
.env
.env.*
secrets/
credentials/
credentials.json
*.pem
*.key
*.p12
*.pfx

# 데이터 및 실험용 경로의 Git 관리 문서와 빈 폴더 표시 파일
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/README.md
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/README.md
/data/yolo/*
!/data/yolo/.gitkeep
!/data/yolo/README.md
/outputs/*
!/outputs/.gitkeep
!/outputs/README.md
/runs/*
!/runs/README.md

# 지정 경로 밖에 저장된 영상·이미지 및 데이터 압축 파일
*.[mM][pP]4
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM]4[vV]
*.[wW][eE][bB][mM]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[bB][mM][pP]
*.[wW][eE][bB][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# 모델 가중치 및 내보낸 모델
